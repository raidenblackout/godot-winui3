<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>GodotWindowsEmbedSample</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <!-- Bundle the WindowsAppSDK runtime so the sample runs without
         requiring the user to install the WindowsAppRuntime 1.6 separately. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <GodotRootBin>$(MSBuildThisFileDirectory)..\..\..\..\bin</GodotRootBin>
    <GodotWindowsEmbedEngineDll>$(GodotRootBin)\godot.windows.template_release.x86_64.dll</GodotWindowsEmbedEngineDll>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.241114003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.22621.3233" />
  </ItemGroup>

  <!-- Engine communication, runtime and lifecycle live in the dedicated
       Godot.WindowsEmbed.Embedding library, which runs the engine on its own thread. -->
  <ItemGroup>
    <ProjectReference Include="..\Godot.WindowsEmbed.Embedding\Godot.WindowsEmbed.Embedding.csproj" />
  </ItemGroup>

  <!-- Bundle the sample IMDF map + rooms data next to the exe. MapViewModel
       reads these via AppContext.BaseDirectory at runtime. -->
  <ItemGroup>
    <Content Include="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Copy the engine DLL next to the sample exe and rename to godot.dll so
       the [DllImport("godot")] in GodotWindowsEmbedEmbed.cs resolves. -->
  <Target Name="ValidateGodotWindowsEmbedEngineDll" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GodotWindowsEmbedEngineDll)')" Text="Godot WindowsEmbed engine DLL was not found at '$(GodotWindowsEmbedEngineDll)'. Build it first from the Godot repo root with: python -m SCons platform=windows windows_embed=yes d3d12=yes library_type=shared_library target=template_release disable_path_overrides=no -j4" />
  </Target>

  <ItemGroup>
    <Content Include="$(GodotWindowsEmbedEngineDll)">
      <Link>godot.dll</Link>
      <TargetPath>godot.dll</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="$(GodotRootBin)\D3D12Core.dll" Condition="Exists('$(GodotRootBin)\D3D12Core.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(GodotRootBin)\d3d12SDKLayers.dll" Condition="Exists('$(GodotRootBin)\d3d12SDKLayers.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Content Update="Assets\basicPlusSample.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\capabilityStatus.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\capturedImageSample.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\devices.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\locations.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\Mapdata1.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\mapview.pck">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\one_room.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\rooms.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\scenes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\service.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\testMap.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\TestProject.pck">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Assets\updatedMap.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
